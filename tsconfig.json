/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "angular-visuals": ["./projects/angular-visuals/src/public-api.ts"],
      "@av/core/*": ["./projects/angular-visuals/src/Core/*"],
      "@av/lib/*": ["./projects/angular-visuals/src/lib/*"],
      "@av/types/*": ["./projects/angular-visuals/src/types/*"],
      "@av/utils/*": ["./projects/angular-visuals/src/utils/*"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/angular-visuals/tsconfig.lib.json"
    },
    {
      "path": "./projects/angular-visuals/tsconfig.spec.json"
    },
    {
      "path": "./projects/av-docs/tsconfig.app.json"
    },
    {
      "path": "./projects/av-docs/tsconfig.spec.json"
    }
  ]
}
